{
  "name": "tanaw",
  "version": "0.1.0",
  "private": true,
  "description": "TANAW — unified accessibility platform for Vision and Hearing & Speech assistance (Android via Capacitor)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/copy-wasm.mjs",
    "cap:sync": "next build && npx cap sync",
    "android:open": "next build && npx cap sync && npx cap open android",
    "android:apk": "next build && npx cap sync && cd android && gradlew.bat assembleDebug",
    "android:build": "next build && npx cap sync && cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "npm run android:build && npm run android:install && adb shell am start -n com.tanaw.app/.MainActivity"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/motion": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@google/genai": "^2.9.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3"
  }
}
